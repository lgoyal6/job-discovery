# Copy to .env; values below are placeholders, never commit secrets.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=job_discovery
POSTGRES_USER=job_pipeline
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql://job_pipeline:replace_me@postgres:5432/job_discovery

N8N_ENCRYPTION_KEY=replace_with_long_random_value
N8N_USER_MANAGEMENT_JWT_SECRET=replace_with_long_random_value
N8N_HOST=localhost
# Railway health checks route to PORT; keep it aligned with N8N_PORT.
PORT=5678
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
# One-time Railway/bootstrap switch. Imports both workflows inactive, then set back to false.
N8N_IMPORT_WORKFLOWS_ON_START=false
GENERIC_TIMEZONE=America/Los_Angeles

EMAIL_TO=you@example.com
# Configure a Gmail OAuth2 credential named "Laksh Gmail" in the n8n UI.
# The Gmail API must be enabled on the credential's Google Cloud project;
# without it every send fails 403 accessNotConfigured while the credential
# itself looks perfectly valid.

NOTION_TOKEN=
# 32-char id from the database URL; the data source id comes from the API.
NOTION_DATABASE_ID=replace_with_notion_database_id
NOTION_DATA_SOURCE_ID=replace_with_notion_data_source_id

APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=curious_coder/linkedin-jobs-scraper
APIFY_INDEED_ACTOR=schnellscrapers/indeed-jobs-scraper
APIFY_MONSTER_ACTOR=axlymxp/monster-scraper
APIFY_MAX_RESULTS_PER_SOURCE=100
APIFY_LINKEDIN_MAX_RESULTS=35
APIFY_INDEED_MAX_RESULTS=15
APIFY_MONSTER_MAX_RESULTS=150
APIFY_MIN_INTERVAL_HOURS=24
APIFY_MAX_ACTOR_RUNS_PER_PIPELINE=3
APIFY_MAX_COMPUTE_UNITS_PER_RUN=1
APIFY_MAX_TOTAL_CHARGE_USD=0.50

COMMUNITY_MAX_RESULTS_PER_SOURCE=300
ATS_MAX_RESULTS_PER_SOURCE=250
SOURCE_TIMEOUT_MS=30000
SOURCE_RETRIES=3
WATCHLIST_COMPANIES_PER_RUN=30

REZZY_API_KEY=
REZZY_PROFILE_ID=
REZZY_WEBHOOK_SECRET=
REZZY_API_BASE_URL=https://api.rezzy.dev/v1
REZZY_DRAFT_PATH=/resume/create

# Runtime safety gates. APIFY_ENABLED uses free-plan credits; the deprecated
# PAID_SOURCES_ENABLED alias remains false. Scheduled email requires SEND_EMAIL_ENABLED=true.
SEND_EMAIL_ENABLED=false
APIFY_ENABLED=false
PAID_SOURCES_ENABLED=false
LOG_LEVEL=info

# The watchlist sits beside the project in the deployed layout (/opt/automation)
# and inside it in a checkout. Leave this empty in production; point it at
# automation/job-company-watchlist.md to run the pipeline or its tests locally.
WATCHLIST_PATH=
